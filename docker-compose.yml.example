# Copy to docker-compose.yml and adapt it to your setup.
services:
  suds:
    build: .
    image: suds:local
    container_name: suds_app
    restart: unless-stopped
    # Publish only on localhost and put a reverse proxy in front of it
    ports:
      - "127.0.0.1:8001:8001"
    # Link to the source code of this deployment (AGPL-3.0); defaults to
    # this repository. Set it if you deploy your own modified version.
    # environment:
    #   SUDS_SOURCE_URL: https://example.org/your/fork
    # Keeps the search index across restarts and rebuilds
    volumes:
      - suds_data:/data

volumes:
  suds_data:
